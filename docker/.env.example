# Mowgli ROS2 v3 — Environment configuration
# Copy to .env and edit: cp .env.example .env
# Then manage the stack with: ./docker/stack.sh up | down | logs -f | regen

# Compose project name — drives the named-volume prefix (install_mowgli_maps).
# Keep stable across the life of an install; renaming orphans persisted maps.
COMPOSE_PROJECT_NAME=install

# Optional fragments toggled by docker/stack.sh (off = mowgli + gps + gui only)
ENABLE_MQTT=false
ENABLE_WATCHTOWER=false

# ROS2 Domain ID — all containers must share the same value for DDS discovery
ROS_DOMAIN_ID=0

# IP of the mower Pi (only needed for ser2net mode)
MOWER_IP=10.0.0.161

# LiDAR serial port and baud rate (LD19 on hardware UART)
LIDAR_PORT=/dev/ttyS1
LIDAR_BAUD=230400

# Docker images built by MowgliNext
MOWGLI_ROS2_IMAGE=ghcr.io/mowglinext/mowglinext/mowgli-ros2:main
LIDAR_IMAGE=ghcr.io/mowglinext/mowglinext/lidar-ldlidar:main
MAVROS_IMAGE=ghcr.io/mowglinext/mowglinext/mavros:main
GUI_IMAGE=ghcr.io/mowglinext/mowglinext/mowglinext-gui:main

# Universal GNSS is released independently from MowgliNext IMAGE_TAG.
# v0.7.1-rc3 publishes the Lyrical image for MowgliNext.
UNIVERSAL_GNSS_IMAGE=ghcr.io/pepeuch/universal-gnss-ros2-lyrical:v0.7.1-rc3@sha256:4e7960132882f2f83fb2b1e7d1430b4dfd00081d4be15d7d8ab20dacf7f22bc5

# Group owning the receiver tty (dialout). The receiver port, family, baud and
# NTRIP settings are NOT here: the sidecar reads them from mowgli_robot.yaml.
GNSS_DEVICE_GID=20
