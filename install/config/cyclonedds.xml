<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <!-- Every container runs with network_mode: host + ipc: host, so all
           ROS2 participants share this host's loopback. Pin DDS to "lo" and
           disable multicast so discovery/traffic never leaves the machine.
           The previous autodetermine="true" let Cyclone pick an external
           NIC and try to talk over WiFi/Ethernet, which broke GPS/RTK
           (UDP write failures + bridge crashes). See issue #418. -->
      <AllowMulticast>false</AllowMulticast>
      <Interfaces>
        <NetworkInterface name="lo" priority="default"/>
      </Interfaces>
    </General>
    <Discovery>
      <!-- Raised from default (9) to keep us comfortably above the
           total participant count once every container + short-lived
           CLI clients have joined. -->
      <MaxAutoParticipantIndex>500</MaxAutoParticipantIndex>
      <!-- Multicast is disabled above, so seed unicast discovery on lo. -->
      <Peers>
        <!-- PruneDelay="inf" (Cyclone DDS >= 11): Cyclone 11 pings a configured
             peer address only twice at start-up and prunes it after
             Discovery/InitialLocatorPruneDelay (30 s) when no participant answered.
             A single UDP receive drop during the boot burst (~40 participants
             announcing at once, 208 KiB default socket buffers) then leaves two
             participants mutually blind FOREVER: 2026-09-15 the Nav2 lifecycle
             manager never saw smoother_server's get_state service while every
             other pair discovered fine, so Nav2 never came up after a container
             restart. Cyclone 0.10 re-announced to every peer port every SPDP
             interval; "inf" restores that (the traffic ran for months). The
             installer also raises net.core.rmem_max so the boot burst is not
             dropped in the first place (install/lib/sysctl.sh). -->
        <Peer Address="localhost" PruneDelay="inf"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
