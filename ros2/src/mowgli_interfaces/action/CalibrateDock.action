# One-click unified dock calibration.
#
# Served by dock_calibration_node (`~/calibrate_dock`). Runs the whole
# sequence in one action so the GUI shows live progress and a single
# retry surface (replaces the old blocking CalibrateImuYaw service +
# the map_server /set_docking_point "capture from robot" button):
#
#   1. Wait for RTK-Fixed (σ(xy) gate on /gps/pose_cov), robot on the dock.
#   2. STILL on the dock and charging: have map_server capture the RAW GPS
#      antenna position (~/capture_dock_antenna — charging + RTK + N-Fixed-
#      samples gates, bounded wait). It is held in map_server memory, not
#      persisted: an antenna position is not a dock position until a
#      trustworthy yaw can lever-arm-correct it. This is the ONE moment of the
#      routine where "on the dock" and "RTK-Fixed" are both guaranteed.
#   3. Reverse in a STRAIGHT line under RTK-Fixed on /cmd_vel_docking
#      (blade OFF, collision_monitor active), monitoring COG.
#   4. Gate COG coherence (circular std + bearing match + min displacement);
#      derive the dock chassis yaw from the reverse leg.
#   5. Persist via map_server /set_docking_point (the single canonical
#      writer), ONE call, robot OFF the dock: use_pending_antenna +
#      yaw_source=MOTION — x, y and yaw written together. If step 2 produced
#      no capture (or it expired), fall back to preserve_position +
#      yaw_source=MOTION: yaw only, stored x/y kept.
#   6. Re-dock through the production docking pipeline — a pure CONFIRMATION
#      pass. Nothing is measured or saved after it.
#
# Why not persist after the re-dock: docking_server and gps_dock_detection_node
# only read dock_pose_x/y/yaw as ROS parameters at container startup, so the
# step-6 re-dock always steers on the OLD pose and vouches for nothing about
# the new one. Why not capture the position after the re-dock: circular — a
# wrong stored position makes that re-dock stop short of the contacts, so the
# capture that would fix it is never reached (field test 2026-09-17), and the
# receiver often sits at RTK-Float under the dock.
#
# `success` therefore means "yaw AND position were saved". It can come with
# retry_reason RETRY_NO_CHARGE_ON_REDOCK: saved, but step 6 did not reach the
# charger and the robot is NOT on the dock (expected when the old pose was
# wrong) — a warning, not a failure. A yaw-only save is reported as a failure
# (RETRY_PERSIST_FAILED, or RETRY_NO_CHARGE_ON_REDOCK if also not re-docked)
# whose `message` lists the yaw as saved. The new pose only drives docking
# after a mowgli-ros2 restart; `message` always says so.

# ── Goal ──────────────────────────────────────────────────────────────────
bool include_imu_yaw     # also solve the IMU mounting-yaw offset from the straight legs
bool include_mag         # also refresh the magnetometer calibration (figure-8 pass)
---
# ── Result ────────────────────────────────────────────────────────────────
# retry_reason enumerates why a run failed so the GUI can show a specific,
# actionable message and offer Retry. RETRY_NONE (0) accompanies success.
uint8 RETRY_NONE=0
uint8 RETRY_NO_RTK=1                # never reached RTK-Fixed within the timeout
uint8 RETRY_COG_INCOHERENT=2       # COG std too high / bearing mismatch / RTK not truly fixed
uint8 RETRY_INSUFFICIENT_DISPLACEMENT=3  # reverse leg did not travel far enough for a yaw fit
uint8 RETRY_NO_CHARGE_ON_REDOCK=4  # confirmation re-dock did not reach the charger (see `message` for what was saved)
uint8 RETRY_EMERGENCY=5            # emergency latched / triggered mid-sequence
uint8 RETRY_WRONG_STATE=6          # robot not on dock at start, or in AUTONOMOUS/mowing
uint8 RETRY_PERSIST_FAILED=7       # set_docking_point rejected or file not writable

bool success
uint8 retry_reason
string message

# Persisted dock pose as STORED by map_server (x/y updated only when success;
# the yaw is persisted whenever the run got past step 5 — see `message`)
float64 dock_pose_x            # ENU map-frame x of the dock contact (m)
float64 dock_pose_y            # ENU map-frame y of the dock contact (m)
float64 dock_pose_yaw_rad      # chassis heading when docked (ENU, rad)
float64 dock_pose_yaw_deg      # same in degrees
float64 dock_yaw_sigma_deg     # 1σ on the computed dock yaw (deg)
float64 cog_std_deg            # circular std of the COG samples over the reverse leg
float64 reverse_displacement_m # GPS-measured reverse distance

# Optional IMU mounting-offset result (valid only when include_imu_yaw and success)
bool imu_yaw_valid
float64 imu_yaw_rad
float64 imu_yaw_deg
float64 imu_pitch_rad
float64 imu_roll_rad
---
# ── Feedback ──────────────────────────────────────────────────────────────
uint8 PHASE_WAIT_RTK=0
uint8 PHASE_REVERSING=1
uint8 PHASE_CHECK_COG=2
uint8 PHASE_REDOCKING=3
uint8 PHASE_VERIFY_CHARGE=4
uint8 PHASE_PERSIST=5
uint8 PHASE_CAPTURE_POSITION=8  # mirrors DockCalibrationStatus (6/7 are IDLE/DONE there)

uint8 phase
float32 progress          # 0.0 .. 1.0 over the whole sequence
float32 cog_std_deg       # running circular std of COG samples (deg)
float32 displacement_m    # GPS displacement so far on the current leg (m)
bool charging             # latest firmware charging state
string message
