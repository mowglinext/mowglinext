# Fleet-owned stop/resume, independent of ordinary HighLevelControl semantics.
uint8 QUERY=0
uint8 PAUSE=1
uint8 RESUME=2
uint8 CANCEL=3
uint8 operation
# Opaque server fence returned by QUERY. Never persisted or adopted after restart.
string epoch
# Fresh client UUID per pause lifecycle; retain it across transport retries.
string request_id
---
uint8 AVAILABLE=0
uint8 HELD=1
uint8 RESUMED=2
uint8 ALREADY_RESUMED=3
uint8 CANCELLED=4
uint8 NOT_READY=5
uint8 INELIGIBLE=6
uint8 BUSY=7
uint8 REVOKED=8
uint8 INVALID=9
uint8 result
# Current server fence, including after terminal operations. It is NOT a new hold.
string epoch
# Whether any client currently owns a hold; QUERY never grants ownership.
bool held
string message
